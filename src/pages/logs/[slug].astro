---
import Terminal from '../../layouts/Terminal.astro';
import ReadingPane from '../../components/ReadingPane.astro';
import { getCollection, render } from 'astro:content';
import { getSignatureStatus } from '../../lib/signature-status';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  return logs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const signatureStatus = getSignatureStatus(entry);
const signedAt = signatureStatus.signedAt ?? entry.data.signature?.signedAt ?? null;
const signer = entry.data.signature?.signer ?? 'silky.moe';

const pubDateFmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

const timeFmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  timeZoneName: 'short',
});

const signedFileName = entry.data.signature?.signedFile.split('/').pop() ?? '';
const signatureFileName = entry.data.signature?.signatureFile.split('/').pop() ?? '';
---

<Terminal title={`~/logs/${entry.slug}`}>
  <article class="log-entry">
    <header class="terminal-header">
      <p class="back-nav">
        <a class="back-nav-link" href="/logs" aria-label="Back to system logs">
          <span class="back-nav-cmd">cd ../</span>
          <span class="back-nav-hint">&larr; back to system logs</span>
        </a>
      </p>
      <p class="label">&gt; cat /system_logs/{entry.slug}.md</p>
    </header>

    <ReadingPane label={`LOG / ${entry.slug}.md`}>
      <header class="reader-header">
        <h1>{entry.data.title}</h1>
        <div class="reader-meta">
          <p>Published {pubDateFmt.format(entry.data.pubDate)}</p>
          {entry.data.updatedDate && <p>Updated {pubDateFmt.format(entry.data.updatedDate)}</p>}
        </div>
      </header>

      <div class="content">
        <Content />
      </div>
    </ReadingPane>

    {
      entry.data.signature ? (
        <section class="signature-box">
            <p class="label">&gt; signature_status: {signatureStatus.label} - {signer}</p>
            {signatureStatus.warning && (
                <p class="sig-warning" role="status"><span class="sig-warning-text">[WARN] {signatureStatus.warning}. Treated as unsigned.</span></p>
            )}
          <p>
            Fingerprint: <span class="val">{entry.data.signature.fingerprint}</span>
          </p>
          <p>
            Signed: <span class="val">{signedAt ? timeFmt.format(signedAt) : 'unknown'}</span>
          </p>
          <p>
            Signed source:{' '}
            <a href={entry.data.signature.signedFile} target="_blank" rel="noopener">
              {entry.data.signature.signedFile}
            </a>
          </p>
          <p>
            Detached signature:{' '}
            <a href={entry.data.signature.signatureFile} target="_blank" rel="noopener">
              {entry.data.signature.signatureFile}
            </a>
          </p>
          <pre>gpg --import pgp_public.asc
gpg --verify {signatureFileName} {signedFileName}</pre>
        </section>
      ) : (
        <section class="signature-box">
          <p class="label">&gt; signature_status: unsigned</p>
          <p class="meta">This log entry has no detached PGP signature yet.</p>
          <p class="signature-footer unsigned"><span class="unsigned-text">⚠ UNSIGNED</span></p>
        </section>
      )
    }
  </article>
</Terminal>

<style>
  .log-entry {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .terminal-header {
    display: flex;
    flex-direction: column;
  }

  .label {
    margin: 0;
    opacity: 0.75;
    overflow-wrap: anywhere;
  }

  .back-nav {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .back-nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--phosphor-dim);
  }

  .back-nav-cmd {
    color: var(--phosphor-muted);
    font-size: 1.08rem;
  }

  .back-nav-hint {
    opacity: 0.72;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-underline-offset: 0.1em;
  }

  h1 {
    margin: 0;
    color: var(--reader-text);
    font-size: clamp(1.85rem, 4vw, 2.65rem);
    line-height: 1.14;
    text-wrap: balance;
  }

  .reader-header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--reader-border);
    margin-bottom: 1.55rem;
  }

  .reader-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: 0.8rem;
    color: var(--reader-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .reader-meta p {
    margin: 0;
  }

  .content :global(p) {
    margin: 0 0 1.15rem;
    max-width: 70ch;
  }

  .content :global(a) {
    color: var(--reader-accent-bright);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }

  .content :global(h2),
  .content :global(h3) {
    color: var(--reader-text);
    margin-top: 1.8rem;
    margin-bottom: 0.7rem;
    line-height: 1.25;
  }

  .content :global(code) {
    border: 1px solid var(--reader-border);
    padding: 0.05rem 0.25rem;
    color: var(--reader-text);
    background: var(--reader-bg-raised);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .content :global(pre) {
    border: 1px solid var(--reader-border);
    padding: 1rem;
    overflow-x: auto;
    color: var(--reader-text);
    background: var(--reader-bg-raised);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .content :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0.15rem 0 0.15rem 1rem;
    color: var(--reader-muted);
    border-left: 3px solid var(--reader-accent);
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.35rem 0;
  }

  .content > :global(:last-child) {
    margin-bottom: 0;
  }

  .signature-box {
    border: 1px dashed var(--phosphor);
    padding: 0.8rem;
    background: rgba(10, 8, 5, 0.45);
  }

  .signature-box p {
    margin: 0.4rem 0;
  }

  .signature-box pre {
    margin: 0.8rem 0 0;
    border: 1px dashed var(--phosphor);
    padding: 0.7rem;
    background: rgba(10, 8, 5, 0.6);
  }

  .sig-warning {
    color: #ff7a4a;
    text-transform: uppercase;
  }

  .sig-warning-text {
    animation: terminalWarnBlink 1s step-end infinite;
  }

  .signature-footer {
    margin-top: 0.8rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--phosphor-border-mid);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .signature-footer.signed {
    color: var(--phosphor);
  }

  .signature-footer.unsigned {
    color: #ff7a4a;
  }

  .signature-footer.unsigned .unsigned-text {
    animation: terminalWarnBlink 1.2s step-end infinite;
  }

  @keyframes terminalWarnBlink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.25;
    }
  }

  .val {
    color: var(--phosphor);
  }
</style>
