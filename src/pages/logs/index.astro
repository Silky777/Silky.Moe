---
import Terminal from '../../layouts/Terminal.astro';
import { getCollection } from 'astro:content';
import { getSignatureStatus } from '../../lib/signature-status';

const logs = (await getCollection('logs')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function stripMarkdown(input: string) {
	return input
		.replace(/```[\s\S]*?```/g, ' ')
		.replace(/`([^`]+)`/g, '$1')
		.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
		.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
		.replace(/^\s{0,3}#{1,6}\s+/gm, '')
		.replace(/[>*_-]{2,}/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
}

const logsWithPreview = logs.map((entry) => {
	const bodyText = stripMarkdown(entry.body || '');
	const preview = bodyText.length > 280 ? `${bodyText.slice(0, 280).trim()}...` : bodyText;
	const signatureStatus = getSignatureStatus(entry);
	const signer = entry.data.signature?.signer ?? 'silky.moe';
	return {
		entry,
		preview: preview || '[no preview text]',
		signatureStatus,
		signer,
	};
});

const verifiedCount = logsWithPreview.filter(({ signatureStatus }) => signatureStatus.label === 'signed').length;

const dateFmt = new Intl.DateTimeFormat('en-GB', {
	year: 'numeric',
	month: 'short',
	day: '2-digit',
});
---

<Terminal title="~/logs">
	<section class="logs-feed">
		<header class="archive-header">
			<div class="archive-heading">
				<p class="label">&gt; ls -lt /system_logs</p>
				<h1>System logs</h1>
				<p class="archive-intro">Long-form writing and site notes, newest first. Signature state is verified at build time.</p>
			</div>

			<dl class="archive-stats" aria-label="System logs summary">
				<div>
					<dt>ENTRIES</dt>
					<dd>{String(logsWithPreview.length).padStart(2, '0')}</dd>
				</div>
				<div>
					<dt>VERIFIED</dt>
					<dd>{String(verifiedCount).padStart(2, '0')}</dd>
				</div>
			</dl>
		</header>

		{
			logsWithPreview.length === 0 ? (
				<p class="dim">No log entries yet.</p>
			) : (
				<div class="archive">
					<div class="archive-sort" aria-hidden="true">
						<span>INDEX / DESCENDING</span>
						<span>{logsWithPreview.length} RECORD{logsWithPreview.length === 1 ? '' : 'S'}</span>
					</div>

					<ol class="log-list" aria-label="System logs archive">
						{logsWithPreview.map(({ entry, preview, signatureStatus, signer }, index) => (
							<li>
								<a class="entry-link" href={`/logs/${entry.slug}`}>
									<div class="entry-sequence">
										<span>LOG_{String(logsWithPreview.length - index).padStart(3, '0')}</span>
										{index === 0 && <span class="latest">LATEST</span>}
									</div>

									<div class="entry-copy">
										<h2>{entry.data.title}</h2>
										<p>{preview}</p>
									</div>

									<div class="entry-side">
										<time datetime={entry.data.pubDate.toISOString()}>{dateFmt.format(entry.data.pubDate)}</time>
										<span class={`status ${signatureStatus.label}`}>
											<span class="status-text">{signatureStatus.label === 'unsigned' ? '⚠ UNSIGNED' : `SIGNED / ${signer}`}</span>
										</span>
										<span class="read-command">cat entry.md&nbsp;→</span>
									</div>
								</a>
							</li>
						))}
					</ol>
				</div>
			)
		}

		<p class="prompt">guest@sys:~/system_logs$ <span class="blink">_</span></p>
	</section>
</Terminal>

<style>
	.logs-feed {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		max-width: 960px;
		margin-inline: auto;
	}

	.archive-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: end;
		padding: 0.5rem 0 1.4rem;
		border-bottom: 1px solid var(--phosphor-border-mid);
	}

	.archive-heading {
		min-width: 0;
	}

	.label {
		margin: 0;
		opacity: 0.75;
	}

	h1 {
		margin: 0.5rem 0 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
		text-transform: lowercase;
	}

	.archive-intro {
		max-width: 58ch;
		margin: 0.9rem 0 0;
		color: var(--phosphor-muted);
		font-size: 0.96rem;
		line-height: 1.55;
	}

	.archive-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(6.5rem, 1fr));
		margin: 0;
		border: 1px solid var(--phosphor-border-mid);
		background: rgba(255, 176, 0, 0.025);
	}

	.archive-stats div {
		padding: 0.8rem 1rem 0.7rem;
	}

	.archive-stats div + div {
		border-left: 1px solid var(--phosphor-border-mid);
	}

	.archive-stats dt {
		color: var(--phosphor-dim);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.archive-stats dd {
		margin: 0.2rem 0 0;
		font-size: 1.5rem;
		line-height: 1;
	}

	.dim {
		margin: 0 0 0.6rem;
		color: var(--phosphor-dim);
	}

	.archive {
		min-width: 0;
	}

	.archive-sort {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0 0 0.55rem;
		color: var(--phosphor-dim);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.log-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--phosphor-border-mid);
	}

	.log-list li {
		border-bottom: 1px solid var(--phosphor-border-mid);
	}

	.entry-link {
		display: grid;
		grid-template-columns: 6.4rem minmax(0, 1fr) minmax(9rem, auto);
		gap: 1.4rem;
		align-items: start;
		padding: 1.35rem 0.8rem;
		color: var(--phosphor);
		background: transparent;
		transition:
			background-color 120ms ease,
			padding 120ms ease;
	}

	.entry-link:hover,
	.entry-link:focus-visible {
		color: var(--phosphor);
		background: rgba(255, 176, 0, 0.065);
		text-shadow: var(--glow);
	}

	.entry-link:focus-visible {
		outline-offset: -2px;
	}

	.entry-sequence {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding-top: 0.2rem;
		color: var(--phosphor-dim);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
	}

	.latest {
		width: fit-content;
		padding: 0.12rem 0.3rem;
		color: var(--bg-color);
		background: var(--phosphor);
		font-size: 0.62rem;
		text-shadow: none;
	}

	.entry-copy {
		min-width: 0;
	}

	.entry-copy h2 {
		margin: 0;
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		font-weight: 500;
		line-height: 1.2;
		text-wrap: balance;
	}

	.entry-copy p {
		max-width: 68ch;
		margin: 0.65rem 0 0;
		color: var(--phosphor-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.entry-side {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.45rem;
		color: var(--phosphor-dim);
		font-size: 0.72rem;
		line-height: 1.35;
		text-align: right;
	}

	.status {
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.status.signed {
		color: var(--phosphor);
	}

	.read-command {
		margin-top: 0.25rem;
		color: var(--phosphor-muted);
		opacity: 0;
		transform: translateX(-0.35rem);
		transition:
			opacity 120ms ease,
			transform 120ms ease;
		white-space: nowrap;
	}

	.entry-link:hover .read-command,
	.entry-link:focus-visible .read-command {
		opacity: 1;
		transform: translateX(0);
	}

	.status.unsigned .status-text {
		color: #ff7a4a;
		animation: terminalWarnBlink 1s step-end infinite;
	}

	.prompt {
		margin: 0;
		color: var(--phosphor-dim);
		font-size: 0.8rem;
	}

	.blink {
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@keyframes terminalWarnBlink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0.25;
		}
	}

	@media (max-width: 820px) {
		.archive-header {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.archive-stats {
			width: min(100%, 18rem);
		}

		.entry-link {
			grid-template-columns: 5.2rem minmax(0, 1fr);
		}

		.entry-side {
			grid-column: 2;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-start;
			text-align: left;
		}

		.read-command {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.logs-feed {
			gap: 1.2rem;
		}

		.archive-header {
			padding-top: 0;
		}

		h1 {
			font-size: 2.25rem;
		}

		.archive-sort {
			font-size: 0.62rem;
		}

		.entry-link {
			grid-template-columns: 1fr;
			gap: 0.7rem;
			padding: 1.15rem 0.35rem;
		}

		.entry-sequence {
			flex-direction: row;
			align-items: center;
		}

		.entry-side {
			grid-column: 1;
			justify-content: space-between;
		}

		.entry-copy h2 {
			font-size: 1.35rem;
		}
	}
</style>
